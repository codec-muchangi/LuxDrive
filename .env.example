# ============================================================
# LUXDRIVE — Environment Variables Template
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to version control.
# ============================================================

# ---- SUPABASE (Backend — FastAPI) -------------------------
# Found in: Supabase Dashboard → Project Settings → API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# ---- APPLICATION (FastAPI) --------------------------------
APP_ENV=development
# development | staging | production
APP_NAME=LUXDRIVE
APP_VERSION=1.0.0
SECRET_KEY=your-strong-random-secret-key-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ---- CORS -------------------------------------------------
# Comma-separated list of allowed frontend origins
FRONTEND_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ---- DATABASE (direct PostgreSQL if needed) ---------------
DATABASE_URL=postgresql://postgres:your-password@db.your-project-ref.supabase.co:5432/postgres

# ---- PAYMENT (M-Pesa / Daraja API) -----------------------
MPESA_CONSUMER_KEY=your-mpesa-consumer-key
MPESA_CONSUMER_SECRET=your-mpesa-consumer-secret
MPESA_BUSINESS_SHORT_CODE=your-business-short-code
MPESA_PASSKEY=your-mpesa-passkey
MPESA_CALLBACK_URL=https://your-backend-domain.com/api/v1/payments/mpesa/callback
MPESA_ENVIRONMENT=sandbox
# sandbox | production

# ---- PAYMENT (Card — Stripe or other) --------------------
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key
STRIPE_WEBHOOK_SECRET=whsec_your-stripe-webhook-secret
STRIPE_PUBLISHABLE_KEY=pk_test_your-stripe-publishable-key

# ---- EMAIL SERVICE ----------------------------------------
EMAIL_API_KEY=your-email-service-api-key
EMAIL_FROM_ADDRESS=noreply@luxdrive.co.ke
EMAIL_FROM_NAME=LUXDRIVE

# ---- SMS SERVICE (optional) ------------------------------
SMS_API_KEY=your-sms-service-api-key
SMS_SENDER_ID=LUXDRIVE

# ---- STORAGE ---------------------------------------------
# Supabase Storage is used — no extra config needed beyond Supabase keys
# Max upload size in MB
MAX_UPLOAD_SIZE_MB=10

# ---- FRONTEND (Vite — VITE_ prefix exposes to browser) ---
# These are safe to expose — they are the public Supabase keys only
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
VITE_API_BASE_URL=http://localhost:8000
VITE_APP_NAME=LUXDRIVE
VITE_APP_ENV=development

# ---- RATE LIMITING ----------------------------------------
RATE_LIMIT_PER_MINUTE=60

# ---- BOOKING SETTINGS -------------------------------------
# Minimum rental days
MIN_RENTAL_DAYS=1
# Maximum rental days
MAX_RENTAL_DAYS=90
# Minimum hours before pickup (booking notice)
MIN_BOOKING_NOTICE_HOURS=4
# Pending booking expiry in minutes
PENDING_BOOKING_EXPIRY_MINUTES=30

# ---- TAX -------------------------------------------------
# VAT / Tax rate as decimal (e.g. 0.16 = 16%)
TAX_RATE=0.16
DEFAULT_CURRENCY=KES
