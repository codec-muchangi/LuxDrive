# ============================================================
# LUXDRIVE — .gitignore
# ============================================================

# --- Environment / Secrets (NEVER commit these) ---
.env
.env.local
.env.development
.env.production
.env.staging
*.env

# --- Node / Frontend ---
node_modules/
dist/
build/
.vite/
*.local

# --- Python / Backend ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
pip-log.txt
pip-delete-this-directory.txt
*.egg-info/
.eggs/
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# --- IDEs & Editors ---
.vscode/
.idea/
*.swp
*.swo
*.sublime-project
*.sublime-workspace
.DS_Store
Thumbs.db

# --- Logs ---
*.log
logs/

# --- Uploads / Media (local dev) ---
uploads/
media/

# --- Testing ---
coverage/
.nyc_output/

# --- Misc ---
*.bak
*.tmp
*.temp
